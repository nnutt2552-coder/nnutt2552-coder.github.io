<!DOCTYPE html>
<html lang="th" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>งานคงค้าง - Pending Task Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        },
                        slateDark: '#0f172a',
                    },
                    fontFamily: {
                        sans: ['Prompt', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Prompt & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Vue.js 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <style>
        body {
            font-family: 'Prompt', 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.4);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(107, 114, 128, 0.7);
        }
        .glass-effect {
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="h-full bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors duration-200 antialiased selection:bg-blue-500 selection:text-white">
    <div id="app" class="min-h-full flex flex-col md:flex-row">

        <!-- Desktop Sidebar -->
        <aside class="hidden md:flex flex-col w-64 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700/60 p-5 shrink-0 justify-between sticky top-0 h-screen z-20">
            <div>
                <!-- App Logo/Header -->
                <div class="flex items-center gap-3 px-2 py-3 mb-6 border-b border-slate-100 dark:border-slate-700/50">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
                        <i class="fa-solid fa-list-check text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg text-slate-900 dark:text-white tracking-tight leading-tight">งานคงค้าง</h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400">ระบบติดตามงานเรียน</p>
                    </div>
                </div>

                <!-- Add Task Quick Button -->
                <button @click="openAddTaskModal()" class="w-full py-3 px-4 mb-6 bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white font-medium rounded-xl shadow-lg shadow-blue-500/25 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus text-sm"></i>
                    <span>เพิ่มงานใหม่</span>
                </button>

                <!-- Navigation Links -->
                <nav class="space-y-1.5">
                    <button v-for="nav in navItems" :key="nav.id" @click="currentTab = nav.id" 
                        :class="[currentTab === nav.id ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white', 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm transition-colors']">
                        <div class="flex items-center gap-3">
                            <i :class="[nav.icon, 'text-base w-5 text-center']"></i>
                            <span>{{ nav.label }}</span>
                        </div>
                        <span v-if="nav.badge !== undefined" :class="[nav.badgeColor || 'bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300', 'text-xs font-semibold px-2 py-0.5 rounded-full']">
                            {{ nav.badge }}
                        </span>
                    </button>
                </nav>
            </div>

            <!-- Bottom Utilities -->
            <div class="border-t border-slate-100 dark:border-slate-700/50 pt-4 space-y-2">
                <button @click="toggleTheme()" class="w-full flex items-center justify-between px-3.5 py-2.5 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 rounded-xl transition">
                    <div class="flex items-center gap-3">
                        <i :class="isDark ? 'fa-solid fa-moon text-amber-400' : 'fa-solid fa-sun text-amber-500'"></i>
                        <span>{{ isDark ? 'โหมดกลางคืน' : 'โหมดสว่าง' }}</span>
                    </div>
                    <span class="text-xs text-slate-400 dark:text-slate-500">{{ isDark ? 'เปิด' : 'ปิด' }}</span>
                </button>

                <div class="px-3.5 py-2 bg-slate-100/70 dark:bg-slate-700/40 rounded-xl text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
                    <span><i class="fa-solid fa-hard-drive mr-1"></i> บันทึกในเครื่อง</span>
                    <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">พร้อมใช้งาน</span>
                </div>
            </div>
        </aside>

        <!-- Mobile Top Header -->
        <header class="md:hidden sticky top-0 z-20 bg-white/90 dark:bg-slate-800/90 glass-effect border-b border-slate-200 dark:border-slate-700/60 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-sm">
                    <i class="fa-solid fa-list-check text-xs"></i>
                </div>
                <h1 class="font-bold text-base text-slate-900 dark:text-white">งานคงค้าง</h1>
            </div>
            <div class="flex items-center gap-2">
                <button @click="openAddTaskModal()" class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs shadow-md shadow-blue-500/20 active:scale-95 transition">
                    <i class="fa-solid fa-plus"></i>
                </button>
                <button @click="toggleTheme()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center text-xs">
                    <i :class="isDark ? 'fa-solid fa-moon text-amber-400' : 'fa-solid fa-sun text-amber-500'"></i>
                </button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full pb-24 md:pb-8 overflow-x-hidden">
            
            <!-- Draft Autosave Status Notification Banner -->
            <transition name="fade">
                <div v-if="draftNotification" class="mb-4 p-3 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800/50 rounded-xl flex items-center justify-between text-xs text-amber-800 dark:text-amber-300">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk animate-bounce"></i>
                        <span>มีร่างงานที่ยังไม่ได้บันทึกไว้ล่าสุด</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button @click="resumeDraft()" class="px-2.5 py-1 bg-amber-600 text-white rounded-lg font-medium hover:bg-amber-700">ดึงร่างงาน</button>
                        <button @click="discardDraft()" class="px-2 py-1 text-amber-600 dark:text-amber-400 hover:underline">ละทิ้ง</button>
                    </div>
                </div>
            </transition>

            <!-- TAB 1: PENDING TASKS (งานที่ยังไม่เสร็จ) -->
            <section v-if="currentTab === 'pending'" class="space-y-6">
                <!-- Page Title & Header Actions -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <span>งานที่ยังไม่เสร็จ</span>
                            <span class="text-xs font-semibold px-2.5 py-1 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full">{{ activePendingTasks.length }} รายการ</span>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">งานที่ต้องดำเนินการส่งตามลำดับความสำคัญ</p>
                    </div>

                    <!-- Add Button Mobile Hidden/Visible -->
                    <button @click="openAddTaskModal()" class="sm:flex hidden items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl shadow-md shadow-blue-500/20 active:scale-95 transition text-sm">
                        <i class="fa-solid fa-plus"></i>
                        <span>เพิ่มงานใหม่</span>
                    </button>
                </div>

                <!-- Priority Legend Badges Overview -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div v-for="p in priorityLevels" :key="p.key" @click="togglePriorityFilter(p.key)" 
                        :class="[filterPriority === p.key ? 'ring-2 ring-offset-2 dark:ring-offset-slate-900 ring-blue-500' : '', 'p-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 rounded-xl cursor-pointer hover:border-slate-300 dark:hover:border-slate-600 transition']">
                        <div class="flex items-center justify-between">
                            <span :class="[p.badgeBg, p.badgeText, 'text-xs font-semibold px-2 py-0.5 rounded-md flex items-center gap-1']">
                                <span class="w-1.5 h-1.5 rounded-full" :class="p.dotBg"></span>
                                {{ p.label }}
                            </span>
                            <span class="font-bold text-slate-700 dark:text-slate-200 text-sm">
                                {{ getPendingCountByPriority(p.key) }}
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">{{ p.description }}</p>
                    </div>
                </div>

                <!-- Filter & Search Controls -->
                <div class="bg-white dark:bg-slate-800 p-3.5 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-700/60 shadow-sm flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
                    <!-- Search Input -->
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input v-model="searchQuery" type="text" placeholder="ค้นหาชื่องาน, รายวิชา, หรือครูผู้สอน..." 
                            class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white transition">
                        <button v-if="searchQuery" @click="searchQuery = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <!-- Select Filters & Sorters -->
                    <div class="flex flex-wrap items-center gap-2">
                        <!-- Subject Filter -->
                        <select v-model="filterSubject" class="px-3 py-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                            <option value="">ทุกรายวิชา</option>
                            <option v-for="subj in subjects" :key="subj.id" :value="subj.id">{{ subj.name }}</option>
                        </select>

                        <!-- Sort By -->
                        <select v-model="sortBy" class="px-3 py-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                            <option value="dueDate_asc">วันส่ง: เร็วที่สุดก่อน</option>
                            <option value="dueDate_desc">วันส่ง: ช้าที่สุดก่อน</option>
                            <option value="priority">ตามระดับความสำคัญ</option>
                            <option value="title">ตามชื่องาน (A-Z)</option>
                        </select>

                        <button v-if="filterPriority || filterSubject || searchQuery" @click="resetFilters()" class="p-2 text-xs text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-xl transition" title="ล้างการกรอง">
                            <i class="fa-solid fa-rotate-left mr-1"></i> ล้างตัวกรอง
                        </button>
                    </div>
                </div>

                <!-- Pending Task List -->
                <div v-if="filteredPendingTasks.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div v-for="task in filteredPendingTasks" :key="task.id" 
                        class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 rounded-2xl p-4 sm:p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between group relative overflow-hidden">
                        
                        <!-- Top Priority Color Line -->
                        <div :class="['absolute top-0 left-0 right-0 h-1.5', getPriorityInfo(task.dueDate).lineBg]"></div>

                        <div>
                            <!-- Header: Priority Badge + Subject Tag -->
                            <div class="flex items-center justify-between gap-2 mb-3 pt-1">
                                <span :style="{ backgroundColor: getSubjectColor(task.subjectId) + '15', color: getSubjectColor(task.subjectId), borderColor: getSubjectColor(task.subjectId) + '30' }" 
                                    class="text-xs font-semibold px-2.5 py-1 rounded-lg border flex items-center gap-1.5 max-w-[170px] truncate">
                                    <span class="w-2 h-2 rounded-full shrink-0" :style="{ backgroundColor: getSubjectColor(task.subjectId) }"></span>
                                    <span class="truncate">{{ getSubjectName(task.subjectId) }}</span>
                                </span>

                                <span :class="[getPriorityInfo(task.dueDate).badgeBg, getPriorityInfo(task.dueDate).badgeText, 'text-[11px] font-semibold px-2.5 py-1 rounded-md flex items-center gap-1 shrink-0']">
                                    <i class="fa-solid fa-clock text-[10px]"></i>
                                    {{ getPriorityInfo(task.dueDate).label }}
                                </span>
                            </div>

                            <!-- Task Title -->
                            <h3 @click="openTaskDetailModal(task)" class="font-bold text-slate-900 dark:text-white text-base hover:text-blue-600 dark:hover:text-blue-400 cursor-pointer line-clamp-2 mb-2 transition">
                                {{ task.title }}
                            </h3>

                            <!-- Details Preview -->
                            <p v-if="task.description" class="text-slate-500 dark:text-slate-400 text-xs line-clamp-2 mb-3">
                                {{ task.description }}
                            </p>

                            <!-- Teacher Info -->
                            <div v-if="task.teacher" class="text-xs text-slate-600 dark:text-slate-400 flex items-center gap-1.5 mb-3">
                                <i class="fa-solid fa-chalkboard-user text-slate-400 text-xs"></i>
                                <span>ครู: {{ task.teacher }}</span>
                            </div>

                            <!-- Attachments Preview Pills -->
                            <div class="flex flex-wrap items-center gap-2 mb-4 text-[11px] text-slate-500 dark:text-slate-400">
                                <span v-if="task.images && task.images.length" class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700/60 rounded-md flex items-center gap-1">
                                    <i class="fa-solid fa-image text-blue-500"></i> {{ task.images.length }} รูป
                                </span>
                                <span v-if="task.links && task.links.length" class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700/60 rounded-md flex items-center gap-1">
                                    <i class="fa-solid fa-link text-indigo-500"></i> {{ task.links.length }} ลิงก์
                                </span>
                                <span v-if="task.notifications && task.notifications.length" class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700/60 rounded-md flex items-center gap-1">
                                    <i class="fa-solid fa-bell text-amber-500"></i> {{ task.notifications.length }} เตือน
                                </span>
                            </div>
                        </div>

                        <!-- Footer Actions & Due Date -->
                        <div class="border-t border-slate-100 dark:border-slate-700/60 pt-3 mt-2 flex items-center justify-between">
                            <!-- Due Date Badge -->
                            <div class="text-xs">
                                <div class="text-[10px] text-slate-400">กำหนดส่ง</div>
                                <div :class="[getPriorityInfo(task.dueDate).isOverdue ? 'text-rose-600 font-bold' : 'text-slate-700 dark:text-slate-300 font-medium']" class="flex items-center gap-1">
                                    <i class="fa-regular fa-calendar text-[11px]"></i>
                                    {{ formatDateTime(task.dueDate) }}
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex items-center gap-1">
                                <button @click="openEditTaskModal(task)" class="p-2 text-slate-500 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-slate-700/60 rounded-lg transition" title="แก้ไข">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button @click="openCompleteModal(task)" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1 transition">
                                    <i class="fa-solid fa-check"></i>
                                    <span>เสร็จสิ้น</span>
                                </button>
                                <button @click="moveToTrash(task)" class="p-2 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-slate-100 dark:hover:bg-slate-700/60 rounded-lg transition" title="ย้ายไปถังขยะ">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty State -->
                <div v-else class="text-center py-16 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-6">
                    <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/30 text-blue-500 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-800 dark:text-slate-200">ไม่พบรายการงานคงค้าง</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">คุณไม่มีงานที่ตรงตามเงื่อนไข หรือทำส่งครบหมดแล้ว!</p>
                    <button @click="openAddTaskModal()" class="mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-xl hover:bg-blue-700 transition">
                        + เพิ่มงานใหม่ตอนนี้
                    </button>
                </div>
            </section>

            <!-- TAB 2: COMPLETED TASKS (งานที่เสร็จแล้ว) -->
            <section v-if="currentTab === 'completed'" class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <span>งานที่เสร็จแล้ว</span>
                            <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 rounded-full">{{ completedTasks.length }} รายการ</span>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">ประวัติงานที่ส่งเรียบร้อยแล้วพร้อมหลักฐาน</p>
                    </div>

                    <!-- Grouping Toggle Selector -->
                    <div class="flex items-center gap-2 bg-white dark:bg-slate-800 p-1 border border-slate-200 dark:border-slate-700 rounded-xl text-xs">
                        <span class="text-slate-400 px-2 font-medium">จัดกลุ่มตาม:</span>
                        <button v-for="mode in ['subject', 'month', 'date']" :key="mode" @click="completedGroupMode = mode"
                            :class="[completedGroupMode === mode ? 'bg-blue-600 text-white font-semibold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700', 'px-3 py-1.5 rounded-lg transition capitalize']">
                            {{ mode === 'subject' ? 'วิชา' : mode === 'month' ? 'เดือน' : 'วันที่ทำเสร็จ' }}
                        </button>
                    </div>
                </div>

                <!-- Grouped Completed Task Container -->
                <div v-if="Object.keys(groupedCompletedTasks).length > 0" class="space-y-6">
                    <div v-for="(group, groupName) in groupedCompletedTasks" :key="groupName" class="space-y-3">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-200 dark:border-slate-700">
                            <i class="fa-solid fa-folder-open text-blue-500 text-sm"></i>
                            <h3 class="font-bold text-slate-800 dark:text-slate-200 text-sm sm:text-base">{{ groupName }}</h3>
                            <span class="text-xs text-slate-400 font-mono">({{ group.length }})</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div v-for="task in group" :key="task.id" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <span :style="{ backgroundColor: getSubjectColor(task.subjectId) + '15', color: getSubjectColor(task.subjectId) }" class="text-[11px] font-semibold px-2 py-0.5 rounded-md">
                                            {{ getSubjectName(task.subjectId) }}
                                        </span>
                                        <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium bg-emerald-50 dark:bg-emerald-900/30 px-2 py-0.5 rounded">
                                            <i class="fa-solid fa-check-double mr-1"></i>เสร็จสมบูรณ์
                                        </span>
                                    </div>

                                    <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1 line-clamp-1">{{ task.title }}</h4>
                                    
                                    <!-- Completed Proof Image Thumbnail -->
                                    <div v-if="task.completionImage" class="mt-2 mb-3 relative rounded-xl overflow-hidden group/img cursor-pointer" @click="previewImage(task.completionImage)">
