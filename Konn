                const priorityLevels = [
                    { key: 'urgent', label: 'ด่วนมาก (≤ 7 วัน)', description: 'เหลือเวลาน้อยกว่าหรือเท่ากับ 7 วัน', badgeBg: 'bg-rose-100 dark:bg-rose-900/40', badgeText: 'text-rose-700 dark:text-rose-300', dotBg: 'bg-rose-500', lineBg: 'bg-rose-500' },
                    { key: 'warning', label: 'ปานกลาง (≤ 14 วัน)', description: 'เหลือเวลาน้อยกว่าหรือเท่ากับ 14 วัน', badgeBg: 'bg-amber-100 dark:bg-amber-900/40', badgeText: 'text-amber-700 dark:text-amber-300', dotBg: 'bg-amber-500', lineBg: 'bg-amber-500' },
                    { key: 'normal', label: 'ปกติ (≤ 21 วัน)', description: 'เหลือเวลาน้อยกว่าหรือเท่ากับ 21 วัน', badgeBg: 'bg-emerald-100 dark:bg-emerald-900/40', badgeText: 'text-emerald-700 dark:text-emerald-300', dotBg: 'bg-emerald-500', lineBg: 'bg-emerald-500' },
                    { key: 'relaxed', label: 'ผ่อนคลาย (> 21 วัน)', description: 'เหลือเวลามากกว่า 21 วันขึ้นไป', badgeBg: 'bg-slate-100 dark:bg-slate-700/60', badgeText: 'text-slate-700 dark:text-slate-300', dotBg: 'bg-slate-400', lineBg: 'bg-slate-400' },
                ];

                const createFutureDate = (daysAdd, hours = 17, minutes = 0) => {
                    const d = new Date();
                    d.setDate(d.getDate() + daysAdd);
                    d.setHours(hours, minutes, 0, 0);
                    return d.toISOString().slice(0, 16);
                };

                // Reactive Storage Containers (เริ่มต้นด้วยอาร์เรย์ว่างเปล่า)
                const subjects = ref(JSON.parse(localStorage.getItem('pending_app_subjects')) || []);
                const tasks = ref(JSON.parse(localStorage.getItem('pending_app_tasks')) || []);
                const trashTasks = ref(JSON.parse(localStorage.getItem('pending_app_trash')) || []);

                // Task Form State
                const taskForm = ref({
                    id: null,
                    title: '',
                    subjectId: '',
                    teacher: '',
                    dueDate: '',
                    description: '',
                    images: [],
                    links: [],
                    notifications: []
                });

                // Subject Form State
                const subjectForm = ref({
                    id: null,
                    name: '',
                    teacher: '',
                    color: '#3b82f6'
                });

                // Watchers for LocalStorage Syncing
                watch(subjects, (val) => localStorage.setItem('pending_app_subjects', JSON.stringify(val)), { deep: true });
                watch(tasks, (val) => localStorage.setItem('pending_app_tasks', JSON.stringify(val)), { deep: true });
                watch(trashTasks, (val) => localStorage.setItem('pending_app_trash', JSON.stringify(val)), { deep: true });

                watch(taskForm, (val) => {
                    if (showTaskModal.value && !isEditingTask.value && (val.title || val.description)) {
                        localStorage.setItem('pending_app_draft', JSON.stringify(val));
                    }
                }, { deep: true });

                // Computed Tasks Filters
                const activePendingTasks = computed(() => tasks.value.filter(t => !t.completed));
                const completedTasks = computed(() => tasks.value.filter(t => t.completed));

                const filteredPendingTasks = computed(() => {
                    return activePendingTasks.value.filter(t => {
                        const matchesSearch = searchQuery.value === '' || 
                            t.title.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
                            (t.teacher && t.teacher.toLowerCase().includes(searchQuery.value.toLowerCase())) ||
                            getSubjectName(t.subjectId).toLowerCase().includes(searchQuery.value.toLowerCase());
                        
                        const matchesSubject = filterSubject.value === '' || t.subjectId === filterSubject.value;
                        
                        const pInfo = getPriorityInfo(t.dueDate);
                        const matchesPriority = filterPriority.value === '' || pInfo.key === filterPriority.value;

                        return matchesSearch && matchesSubject && matchesPriority;
                    }).sort((a, b) => {
                        if (sortBy.value === 'dueDate_asc') return new Date(a.dueDate) - new Date(b.dueDate);
                        if (sortBy.value === 'dueDate_desc') return new Date(b.dueDate) - new Date(a.dueDate);
                        if (sortBy.value === 'title') return a.title.localeCompare(b.title, 'th');
                        if (sortBy.value === 'priority') {
                            const order = { urgent: 1, warning: 2, normal: 3, relaxed: 4 };
                            return order[getPriorityInfo(a.dueDate).key] - order[getPriorityInfo(b.dueDate).key];
                        }
                        return 0;
                    });
                });

                // Grouping Logic for Completed Tasks
                const groupedCompletedTasks = computed(() => {
                    const groups = {};
                    completedTasks.value.forEach(task => {
                        let groupKey = 'อื่นๆ';
                        if (completedGroupMode.value === 'subject') {
                            groupKey = getSubjectName(task.subjectId);
                        } else if (completedGroupMode.value === 'month') {
                            if (task.completedAt) {
                                const d = new Date(task.completedAt);
                                groupKey = d.toLocaleDateString('th-TH', { month: 'long', year: 'numeric' });
                            }
                        } else if (completedGroupMode.value === 'date') {
                            if (task.completedAt) {
                                groupKey = formatDateOnly(task.completedAt);
                            }
                        }

                        if (!groups[groupKey]) groups[groupKey] = [];
                        groups[groupKey].push(task);
                    });
                    return groups;
                });

                // Priority Calculation Rules (Dynamic based on remaining time)
                function getPriorityInfo(dueDateStr) {
                    if (!dueDateStr) return priorityLevels[3];
                    const now = new Date();
                    const due = new Date(dueDateStr);
                    const diffTime = due - now;
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                    if (diffTime < 0) {
                        return { key: 'urgent', label: 'เลยกำหนดส่ง', description: 'เลยกำหนดส่งแล้ว!', badgeBg: 'bg-rose-200 dark:bg-rose-950', badgeText: 'text-rose-800 dark:text-rose-200', dotBg: 'bg-rose-600', lineBg: 'bg-rose-600', isOverdue: true };
                    }
                    if (diffDays <= 7) return { ...priorityLevels[0], daysLeft: diffDays };
                    if (diffDays <= 14) return { ...priorityLevels[1], daysLeft: diffDays };
                    if (diffDays <= 21) return { ...priorityLevels[2], daysLeft: diffDays };
                    return { ...priorityLevels[3], daysLeft: diffDays };
                }

                function getPendingCountByPriority(priorityKey) {
                    return activePendingTasks.value.filter(t => getPriorityInfo(t.dueDate).key === priorityKey).length;
                }

                // Helper Functions for Subjects
                function getSubjectName(subjectId) {
                    const subj = subjects.value.find(s => s.id === subjectId);
                    return subj ? subj.name : 'ไม่ระบุวิชา';
                }

                function getSubjectColor(subjectId) {
                    const subj = subjects.value.find(s => s.id === subjectId);
                    return subj ? subj.color : '#64748b';
                }

                function getSubjectTaskStats(subjectId) {
                    const pending = activePendingTasks.value.filter(t => t.subjectId === subjectId).length;
                    const completed = completedTasks.value.filter(t => t.subjectId === subjectId).length;
                    return { pending, completed };
                }

                const overallCompletionRate = computed(() => {
                    const total = tasks.value.length;
                    if (total === 0) return 0;
                    return Math.round((completedTasks.value.length / total) * 100);
                });

                // Formatting Helpers
                function formatDateTime(dateTimeStr) {
                    if (!dateTimeStr) return '-';
                    const d = new Date(dateTimeStr);
                    return d.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' }) + ' ' + d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) + ' น.';
                }

                function formatDateOnly(dateTimeStr) {
                    if (!dateTimeStr) return '-';
                    const d = new Date(dateTimeStr);
                    return d.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
                }

                function formatTimeOnly(dateTimeStr) {
                    if (!dateTimeStr) return '-';
                    const d = new Date(dateTimeStr);
                    return d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) + ' น.';
                }

                // Image Compression Utility using Canvas
                function compressImage(file, maxWidth = 800, maxHeight = 800, quality = 0.7) {
                    return new Promise((resolve) => {
                        const reader = new FileReader();
                        reader.readAsDataURL(file);
                        reader.onload = (event) => {
                            const img = new Image();
                            img.src = event.target.result;
                            img.onload = () => {
                                const canvas = document.createElement('canvas');
                                let width = img.width;
                                let height = img.height;

                                if (width > height) {
                                    if (width > maxWidth) {
                                        height = Math.round((height * maxWidth) / width);
                                        width = maxWidth;
                                    }
                                } else {
                                    if (height > maxHeight) {
                                        width = Math.round((width * maxHeight) / height);
                                        height = maxHeight;
                                    }
                                }

                                canvas.width = width;
                                canvas.height = height;
                                const ctx = canvas.getContext('2d');
                                ctx.drawImage(img, 0, 0, width, height);
                                resolve(canvas.toDataURL('image/jpeg', quality));
                            };
                        };
                    });
                }

                // Handle Image Uploads in Task Form
                async function handleImageUpload(e) {
                    const files = e.target.files;
                    if (!files.length) return;
                    for (let file of files) {
                        const compressedBase64 = await compressImage(file);
                        taskForm.value.images.push(compressedBase64);
                    }
                }

                function removeImage(idx) {
                    taskForm.value.images.splice(idx, 1);
                }

                async function handleCompletionImageUpload(e) {
                    const file = e.target.files[0];
                    if (file) {
                        completionProofImage.value = await compressImage(file);
                    }
                }

                // Task Links Helpers
                function addLinkInput() {
                    taskForm.value.links.push({ title: '', url: '' });
                }
                function removeLinkInput(idx) {
                    taskForm.value.links.splice(idx, 1);
                }

                // Notifications Setup Helpers
                function addNotificationInput() {
                    taskForm.value.notifications.push({ type: 'before_due', offsetMinutes: 60, customDateTime: '' });
                }
                function removeNotificationInput(idx) {
                    taskForm.value.notifications.splice(idx, 1);
                }

                // Task Action Handlers
                function openAddTaskModal() {
                    isEditingTask.value = false;
                    taskForm.value = {
                        id: 'task-' + Date.now(),
                        title: '',
                        subjectId: subjects.value[0]?.id || '',
                        teacher: '',
                        dueDate: createFutureDate(7, 17, 0),
                        description: '',
                        images: [],
                        links: [],
                        notifications: [{ type: 'before_due', offsetMinutes: 60 }]
                    };
                    showTaskModal.value = true;
                }

                function openEditTaskModal(task) {
                    isEditingTask.value = true;
                    taskForm.value = JSON.parse(JSON.stringify(task));
                    showTaskModal.value = true;
                }

                function closeTaskModal() {
                    showTaskModal.value = false;
                    localStorage.removeItem('pending_app_draft');
                    draftNotification.value = false;
                }

                function saveTask() {
                    if (!taskForm.value.title || !taskForm.value.subjectId || !taskForm.value.dueDate) return;

                    if (isEditingTask.value) {
                        const idx = tasks.value.findIndex(t => t.id === taskForm.value.id);
                        if (idx !== -1) tasks.value[idx] = { ...taskForm.value };
                    } else {
                        tasks.value.unshift({
                            ...taskForm.value,
                            completed: false,
                            completedAt: null,
                            createdAt: new Date().toISOString()
                        });
                    }

                    closeTaskModal();
                }

                function openCompleteModal(task) {
                    selectedTaskForComplete.value = task;
                    completionProofImage.value = null;
                    completionNote.value = '';
                    showCompleteModal.value = true;
                }

                function confirmTaskCompletion() {
                    if (!selectedTaskForComplete.value) return;
                    const task = tasks.value.find(t => t.id === selectedTaskForComplete.value.id);
                    if (task) {
                        task.completed = true;
                        task.completedAt = new Date().toISOString();
                        task.completionImage = completionProofImage.value;
                        task.completionNote = completionNote.value;
                    }
                    showCompleteModal.value = false;
                }

                function restoreToPending(task) {
                    task.completed = false;
                    task.completedAt = null;
                }

                function moveToTrash(task) {
                    const idx = tasks.value.findIndex(t => t.id === task.id);
                    if (idx !== -1) {
                        const [removed] = tasks.value.splice(idx, 1);
                        trashTasks.value.unshift({ ...removed, deletedAt: new Date().toISOString() });
                    }
                }

                function restoreFromTrash(task) {
                    const idx = trashTasks.value.findIndex(t => t.id === task.id);
                    if (idx !== -1) {
                        const [restored] = trashTasks.value.splice(idx, 1);
                        delete restored.deletedAt;
                        tasks.value.unshift(restored);
                    }
                }

                function permanentlyDelete(task) {
                    trashTasks.value = trashTasks.value.filter(t => t.id !== task.id);
                }

                function emptyTrashAll() {
                    if (confirm('คุณแน่ใจหรือไม่ที่จะลบรายการในถังขยะทั้งหมดถาวร?')) {
                        trashTasks.value = [];
                    }
                }

                function openSubjectModal(subject = null) {
                    if (subject) {
                        isEditingSubject.value = true;
                        subjectForm.value = JSON.parse(JSON.stringify(subject));
                    } else {
                        isEditingSubject.value = false;
                        subjectForm.value = { id: 'sub-' + Date.now(), name: '', teacher: '', color: '#' + Math.floor(Math.random()*16777215).toString(16) };
                    }
                    showSubjectModal.value = true;
                }

                function saveSubject() {
                    if (!subjectForm.value.name) return;
                    if (isEditingSubject.value) {
                        const idx = subjects.value.findIndex(s => s.id === subjectForm.value.id);
                        if (idx !== -1) subjects.value[idx] = { ...subjectForm.value };
                    } else {
                        subjects.value.push({ ...subjectForm.value });
                    }
                    showSubjectModal.value = false;
                }

                function deleteSubject(subj) {
                    if (confirm(`คุณต้องการลบวิชา "${subj.name}" หรือไม่?`)) {
                        subjects.value = subjects.value.filter(s => s.id !== subj.id);
                    }
                }

                function viewSubjectDetail(subj) {
                    filterSubject.value = subj.id;
                    currentTab.value = 'pending';
                }

                function openTaskDetailModal(task) {
                    selectedTask.value = task;
                    showTaskDetailModal.value = true;
                }

                function previewImage(url) {
                    previewImageUrl.value = url;
                }

                function togglePriorityFilter(key) {
                    filterPriority.value = filterPriority.value === key ? '' : key;
                }

                function resetFilters() {
                    filterPriority.value = '';
                    filterSubject.value = '';
                    searchQuery.value = '';
                }

                const currentMonthName = computed(() => currentDate.value.toLocaleDateString('th-TH', { month: 'long' }));
                const currentYear = computed(() => currentDate.value.getFullYear() + 543);

                const calendarDays = computed(() => {
                    const year = currentDate.value.getFullYear();
                    const month = currentDate.value.getMonth();

                    const firstDayOfMonth = new Date(year, month, 1);
                    const lastDayOfMonth = new Date(year, month + 1, 0);

                    const startingDayOfWeek = firstDayOfMonth.getDay(); // 0 = Sun
                    const totalDaysInMonth = lastDayOfMonth.getDate();

                    const days = [];
                    const todayStr = new Date().toISOString().slice(0, 10);

                    // Previous Month Days
                    const prevMonthLastDay = new Date(year, month, 0).getDate();
                    for (let i = startingDayOfWeek - 1; i >= 0; i--) {
                        const d = new Date(year, month - 1, prevMonthLastDay - i);
                        days.push({ dayNum: d.getDate(), isCurrentMonth: false, dateStr: d.toISOString().slice(0, 10), tasks: [] });
                    }

                    // Current Month Days
                    for (let i = 1; i <= totalDaysInMonth; i++) {
                        const d = new Date(year, month, i);
                        const dateStr = d.toISOString().slice(0, 10);

                        // Find tasks due on this date
                        const dayTasks = activePendingTasks.value.filter(t => t.dueDate && t.dueDate.slice(0, 10) === dateStr);

                        days.push({
                            dayNum: i,
                            isCurrentMonth: true,
                            isToday: dateStr === todayStr,
                            dateStr: dateStr,
                            tasks: dayTasks
                        });
                    }

                    // Next Month Padding Days
                    const remainingCells = 42 - days.length;
                    for (let i = 1; i <= remainingCells; i++) {
                        const d = new Date(year, month + 1, i);
                        days.push({ dayNum: i, isCurrentMonth: false, dateStr: d.toISOString().slice(0, 10), tasks: [] });
                    }

                    return days;
                });

                function prevMonth() {
                    currentDate.value = new Date(currentDate.value.getFullYear(), currentDate.value.getMonth() - 1, 1);
                }

                function nextMonth() {
                    currentDate.value = new Date(currentDate.value.getFullYear(), currentDate.value.getMonth() + 1, 1);
                }

                function goToday() {
                    currentDate.value = new Date();
                }

                function selectCalendarDate(day) {
                    if (!day.isCurrentMonth) return;
                    selectedDayData.value = day;
                    showDayDrawer.value = true;
                }

                // Theme Toggle
                function toggleTheme() {
                    isDark.value = !isDark.value;
                    if (isDark.value) {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('pending_theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('pending_theme', 'light');
                    }
                }

                // Check Unsaved Draft
                function checkDraft() {
                    const savedDraft = localStorage.getItem('pending_app_draft');
                    if (savedDraft) {
                        draftNotification.value = true;
                    }
                }

                function resumeDraft() {
                    const savedDraft = localStorage.getItem('pending_app_draft');
                    if (savedDraft) {
                        taskForm.value = JSON.parse(savedDraft);
                        showTaskModal.value = true;
                        draftNotification.value = false;
                    }
                }

                function discardDraft() {
                    localStorage.removeItem('pending_app_draft');
                    draftNotification.value = false;
                }

                // 30-Day Auto Purge Trash
                function autoPurgeTrash() {
                    const now = new Date();
                    trashTasks.value = trashTasks.value.filter(task => {
                        if (!task.deletedAt) return true;
                        const deletedDate = new Date(task.deletedAt);
                        const diffDays = (now - deletedDate) / (1000 * 60 * 60 * 24);
                        return diffDays < 30; // Keep if less than 30 days
                    });
                }

                onMounted(() => {
                    // Load Saved Theme
                    const savedTheme = localStorage.getItem('pending_theme');
                    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                        isDark.value = true;
                        document.documentElement.classList.add('dark');
                    }

                    checkDraft();
                    autoPurgeTrash();
                });

                return {
                    currentTab,
                    navItems,
                    isDark,
                    searchQuery,
                    filterSubject,
                    filterPriority,
                    sortBy,
                    completedGroupMode,
                    priorityLevels,
                    subjects,
                    tasks,
                    trashTasks,
                    activePendingTasks,
                    completedTasks,
                    filteredPendingTasks,
                    groupedCompletedTasks,
                    draftNotification,
                    showTaskModal,
                    isEditingTask,
                    taskForm,
                    showCompleteModal,
                    selectedTaskForComplete,
                    completionProofImage,
                    completionNote,
                    showSubjectModal,
                    isEditingSubject,
                    subjectForm,
                    showTaskDetailModal,
                    selectedTask,
                    showDayDrawer,
                    selectedDayData,
                    previewImageUrl,
                    currentMonthName,
                    currentYear,
                    calendarDays,
                    overallCompletionRate,
                    getPriorityInfo,
                    getPendingCountByPriority,
                    getSubjectName,
                    getSubjectColor,
                    getSubjectTaskStats,
                    formatDateTime,
                    formatDateOnly,
                    formatTimeOnly,
                    handleImageUpload,
                    removeImage,
                    handleCompletionImageUpload,
                    addLinkInput,
                    removeLinkInput,
                    addNotificationInput,
                    removeNotificationInput,
                    openAddTaskModal,
                    openEditTaskModal,
                    closeTaskModal,
                    saveTask,
                    openCompleteModal,
                    confirmTaskCompletion,
                    restoreToPending,
                    moveToTrash,
                    restoreFromTrash,
                    permanentlyDelete,
                    emptyTrashAll,
                    openSubjectModal,
                    saveSubject,
                    deleteSubject,
                    viewSubjectDetail,
                    openTaskDetailModal,
                    previewImage,
                    togglePriorityFilter,
                    resetFilters,
                    prevMonth,
                    nextMonth,
                    goToday,
                    selectCalendarDate,
                    toggleTheme,
                    resumeDraft,
                    discardDraft
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
